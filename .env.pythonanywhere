# =====================================================================
# PythonAnywhere Environment Variables for PropertyBazaar
# =====================================================================
# INSTRUCTIONS:
# 1. Open PythonAnywhere Bash Console
# 2. Run: nano /home/YOUR_USERNAME/propertybazaar/.env
# 3. Paste this content (fill in your actual values)
# 4. Save: Ctrl+X → Y → Enter
# =====================================================================

# REQUIRED: Change this to a strong random key!
# Generate one at: https://djecrety.ir/
SECRET_KEY=your-very-secret-production-key-change-this-50-chars-long

# Production mode
DEBUG=False

# Your PythonAnywhere domain (replace YOUR_USERNAME)
ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com

# Database: SQLite will be used automatically (no setup needed for free tier)

# Email (optional - fill if you want email functionality)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password

# Razorpay (optional - fill if payments needed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
